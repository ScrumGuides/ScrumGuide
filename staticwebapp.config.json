{
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".webmanifest": "application/manifest+json"
  },
  "routes": [
    {
      "comment": "trailingSlash 'always' otherwise 301s this to .json/, and the platform's deployment verification reads it as an exact path.",
      "route": "/.well-known/open-guide-platform.json",
      "headers": {
        "content-type": "application/json"
      }
    },
    {
      "route": "/history/",
      "redirect": "/scrum-guide/history/",
      "statusCode": 301
    },
    {
      "route": "/translations/",
      "redirect": "/scrum-guide/translations/",
      "statusCode": 301
    },
    {
      "route": "/downloads/",
      "redirect": "/scrum-guide/translations/",
      "statusCode": 301
    },
    {
      "route": "/latest/",
      "redirect": "/scrum-guide/latest/",
      "statusCode": 301
    }
  ]
}
